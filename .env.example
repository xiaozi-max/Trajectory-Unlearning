# Copy to .env (git-ignored: never commit real secrets).
# common_utils/experiment_env.sh loads it once for all launchers.
# Replace /ABS/PATH/TO/risk-aware-girpo with this machine's checkout root.

# --- credentials -----------------------------------------------------------
# Gated dataset: accept terms at https://huggingface.co/datasets/CHATS-Lab/MT-AgentRisk
HF_TOKEN=
# Required only for scripts/score_jev.py. The client appends /v1/systemone,
# so JEV_BASE_URL must be the bare API host.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# Only ToolShield's independent post_eval.py / hosted-agent path needs these.
OPENROUTER_API_KEY=
NOTION_TOKEN=
SOURCE_NOTION_KEY=
POSTGRES_DB_URL=
MCP_GMAIL_URL=

# --- paths -----------------------------------------------------------------
MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
TOOLSHIELD_ROOT=/ABS/PATH/TO/risk-aware-girpo/sources/ToolShield-main
TASKS_ROOT=/ABS/PATH/TO/risk-aware-girpo/work/datasets/MT-AgentRisk/workspaces
AGENT_CONFIG_FILE=/ABS/PATH/TO/risk-aware-girpo/configs/mt_agentrisk/agent_config.toml
# Trainer env is a real conda env (Python 3.12). On a NEW machine leave this
# UNSET until scripts/experiments/setup_trainer_conda.sh has created it, then
# set it to "$(conda info --base)/envs/risk-girpo". If set to a wrong path the
# setup script will try to use a python binary that does not exist.
# TRAINER_ENV=/ABS/PATH/TO/miniconda3/envs/risk-girpo

# --- research manifests ----------------------------------------------------
# Create with scripts/prepare_mt_manifests.py and scripts/prepare_test_manifests.py.
# TASK_MANIFESTS is ':'-separated and is what the Gateway loads into its catalog;
# include train + validation + held-out harmful test + benign test.
TRAIN_MANIFEST=/ABS/PATH/TO/risk-aware-girpo/work/manifests/research/terminal_train.jsonl
VAL_MANIFEST=/ABS/PATH/TO/risk-aware-girpo/work/manifests/research/terminal_validation.jsonl
TASK_MANIFESTS=/ABS/PATH/TO/risk-aware-girpo/work/manifests/research/terminal_train.jsonl:/ABS/PATH/TO/risk-aware-girpo/work/manifests/research/terminal_validation.jsonl:/ABS/PATH/TO/risk-aware-girpo/work/manifests/research/test.jsonl:/ABS/PATH/TO/risk-aware-girpo/work/manifests/research/benign_test.jsonl
EVAL_MANIFEST=
# FORGET_POOL / RETAIN_POOL are exported by the launchers AFTER collect.
# Leave them unset here so .env does not clobber explicit values.

# --- gateway / GPU ---------------------------------------------------------
# SSH tunnel: local 18099 -> ECS 127.0.0.1:8099. Use 8099 directly if the
# Gateway runs on the same host.
OPENHANDS_GATEWAY_URL=http://127.0.0.1:18099
OPENHANDS_GATEWAY_TIMEOUT=120
GPU_COUNT=2
GPU_IDS='0 1 2 3'
GPU_WAIT_SECONDS=15
GPU_MIN_MEMORY_MB=30000
GPU_MAX_UTIL=10
GPU_MAX_PROCESSES=8

# --- pilot / training scale ------------------------------------------------
TRAIN_BATCH_SIZE=2
VAL_BATCH_SIZE=2
GROUP_SIZE=2
TRAIN_DRIVER_SIZE=8
VAL_DRIVER_SIZE=2
COLLECT_DRIVER_SIZE=8
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1
MAX_STEPS=10
EPOCHS=1
LEARNING_RATE=1e-6
LORA_RANK=16
LORA_ALPHA=32
MAX_PROMPT_LENGTH=2048
MAX_RESPONSE_LENGTH=1024
TEST_FREQ=-1
SAVE_FREQ=1
MAX_ACTOR_CKPT_TO_KEEP=1
TRAINER_LOGGER='["console"]'
EXPERIMENT_NAME=

# --- optional tracking -----------------------------------------------------
WANDB_API_KEY=
WANDB_PROJECT=risk-aware-girpo
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
