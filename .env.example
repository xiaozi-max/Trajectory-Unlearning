# Copy to .env. common_utils/experiment_env.sh automatically loads it for all
# Risk-aware GiRPO launchers. .env is git-ignored; never commit real secrets.

# Required for the gated MT-AgentRisk dataset. First accept its terms at
# https://huggingface.co/datasets/CHATS-Lab/MT-AgentRisk.
HF_TOKEN=

# Required only when running scripts/score_jev.py.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai

# Local model and data. MODEL_PATH may be a Hugging Face repo ID; it will be
# downloaded into work/huggingface on first use.
MODEL_PATH=Qwen/Qwen2.5-Coder-3B-Instruct
TOOLSHIELD_ROOT=/volume/users/chenyun/lzc/risk-aware-girpo/sources/ToolShield-main
TASKS_ROOT=/volume/users/chenyun/lzc/risk-aware-girpo/work/datasets/MT-AgentRisk/workspaces/terminal/multi_turn_tasks
AGENT_CONFIG_FILE=/volume/users/chenyun/lzc/risk-aware-girpo/configs/mt_agentrisk/agent_config.toml

# Set these after creating a small pilot split with scripts/build_manifests.py.
TRAIN_MANIFEST=
VAL_MANIFEST=
TASK_MANIFESTS=
EVAL_MANIFEST=
FORGET_POOL=
RETAIN_POOL=

# Local gateway / pilot defaults.
OPENHANDS_GATEWAY_URL=http://127.0.0.1:8099
GPU_COUNT=4
TRAINER_LOGGER="['console']"

# Optional experiment tracking and notifications.
WANDB_API_KEY=
WANDB_PROJECT=risk-aware-girpo
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Tool-specific credentials. Terminal/filesystem tasks need none. PostgreSQL
# uses the local POSTGRES_DB_URL. Notion tasks require both Notion tokens.
POSTGRES_DB_URL=postgresql://postgres:password@localhost:5432/postgres
NOTION_TOKEN=
SOURCE_NOTION_KEY=
MCP_GMAIL_URL=

# Only ToolShield's independent OpenRouter post-eval/hosted-agent path needs
# this. It is not needed by the local veRL + gateway pilot.
OPENROUTER_API_KEY=
